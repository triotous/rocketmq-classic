<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.rocketmq.classic.compat</groupId>
  <artifactId>rocketmq-java-reference</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rocketmq.client.version>5.5.1</rocketmq.client.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.apache.rocketmq</groupId>
      <artifactId>rocketmq-client</artifactId>
      <version>${rocketmq.client.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration><mainClass>compat.Main</mainClass></configuration>
        <executions>
          <execution>
            <id>verify-runtime-inbound-routing-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>compat.RuntimeInboundRoutingFixtures</mainClass>
              <arguments>
                <argument>${project.basedir}/../../fixtures/runtime/inbound-routing.json</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-runtime-discovery-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>compat.RuntimeDiscoveryFixtures</mainClass>
              <arguments>
                <argument>${project.basedir}/../../fixtures/runtime/discovery.json</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-runtime-heartbeat-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>compat.RuntimeHeartbeatFixtures</mainClass>
              <arguments>
                <argument>${project.basedir}/../../fixtures/runtime/heartbeat.json</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-runtime-route-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>compat.RuntimeRouteFixtures</mainClass>
              <arguments>
                <argument>${project.basedir}/../../fixtures/runtime/route.json</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-runtime-config-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>compat.RuntimeConfigFixtures</mainClass>
              <arguments>
                <argument>${project.basedir}/../../fixtures/runtime/client-config.json</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-runtime-hook-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>compat.RuntimeHookFixtures</mainClass>
              <arguments>
                <argument>${project.basedir}/../../fixtures/runtime/hooks.json</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-java-invoked-pop-ack-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>compat.PopAckInvokedFixtures</mainClass>
              <arguments>
                <argument>${project.basedir}/../../fixtures/rpc-invoked-pop-ack</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>java-oracle-self-test</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration><arguments><argument>self-test</argument></arguments></configuration>
          </execution>
          <execution>
            <id>verify-java-invoked-rpc-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>rpc-invoked-fixtures</argument><argument>--output</argument>
                <argument>${project.basedir}/../../fixtures/rpc-invoked</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-java-invoked-consumer-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>compat.ConsumerInvokedFixtures</mainClass>
              <arguments>
                <argument>${project.basedir}/../../fixtures/rpc-invoked-consumer</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-java-invoked-producer-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>compat.ProducerInvokedFixtures</mainClass>
              <arguments>
                <argument>${project.basedir}/../../fixtures/rpc-invoked-producer</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-java-invoked-ext-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>rpc-invoked-ext-fixtures</argument><argument>--output</argument>
                <argument>${project.basedir}/../../fixtures/rpc-invoked-ext</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-java-invoked-consumer-more-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>compat.ConsumerMoreInvokedFixtures</mainClass>
              <arguments>
                <argument>${project.basedir}/../../fixtures/rpc-invoked-consumer-more</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-java-invoked-producer-more-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>compat.ProducerMoreInvokedFixtures</mainClass>
              <arguments>
                <argument>${project.basedir}/../../fixtures/rpc-invoked-producer-more</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-java-invoked-ext-more-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>compat.ExtensionMoreInvokedFixtures</mainClass>
              <arguments>
                <argument>${project.basedir}/../../fixtures/rpc-invoked-ext-more</argument>
                <argument>--verify</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-rust-generated-remoting-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>verify-rust-fixtures</argument>
                <argument>--dir</argument>
                <argument>${project.basedir}/../../fixtures/remoting/rust-generated</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-rust-generated-typed-header-fixtures</id>
            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>cargo</executable>
              <workingDirectory>${project.basedir}/../..</workingDirectory>
              <arguments>
                <argument>run</argument><argument>--locked</argument><argument>-p</argument>
                <argument>rocketmq-classic-remoting</argument><argument>--example</argument>
                <argument>generate_fixtures</argument><argument>--</argument>
                <argument>p4-headers</argument><argument>${project.build.directory}/p4-rust-header-fixtures</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-java-typed-header-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments><argument>header-fixtures</argument><argument>--output</argument><argument>${project.basedir}/../../fixtures/remoting</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-java-typed-body-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments><argument>body-fixtures</argument><argument>--output</argument><argument>${project.basedir}/../../fixtures/remoting</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-rust-generated-typed-header-fixtures-java</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>verify-rust-fixtures</argument>
                <argument>--dir</argument>
                <argument>${project.build.directory}/p4-rust-header-fixtures</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-rust-typed-body-fixtures</id>
            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>cargo</executable>
              <workingDirectory>${project.basedir}/../..</workingDirectory>
              <arguments>
                <argument>run</argument><argument>--locked</argument><argument>-p</argument>
                <argument>rocketmq-classic-remoting</argument><argument>--example</argument>
                <argument>generate_fixtures</argument><argument>--</argument>
                <argument>p4-bodies</argument><argument>${project.build.directory}/p4-rust-body-fixtures</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-rust-generated-typed-body-fixtures</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>verify-rust-bodies</argument>
                <argument>--dir</argument>
                <argument>${project.build.directory}/p4-rust-body-fixtures</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>scenario-manifest-validation</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>python3</executable>
              <workingDirectory>${project.basedir}/../..</workingDirectory>
              <arguments><argument>tests/differential/compare.py</argument><argument>--validate-manifest</argument></arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>verify-rocketmq-reference-version</id>
            <phase>validate</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <fail message="RocketMQ Java reference must be exactly 5.5.1">
                  <condition><not><equals arg1="${rocketmq.client.version}" arg2="5.5.1"/></not></condition>
                </fail>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
